# Copy thành backend/.env rồi điền giá trị thật. KHÔNG commit file .env.
DATABASE_URL=postgresql+psycopg://pfa:pfa@localhost:5433/pfa
TEST_DATABASE_URL=postgresql+psycopg://pfa:pfa@localhost:5433/pfa_test

OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Nhiều origin phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
